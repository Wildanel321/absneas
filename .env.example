APP_NAME="Smart Attendance"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://absensi.example.com
APP_TIMEZONE=Asia/Jakarta
APP_KEY=CHANGE_ME_GENERATE_WITH_BIN_KEYGEN

# Database SQLite path (relatif terhadap root proyek atau path absolut)
DB_PATH=storage/database/attendance.sqlite

# Session & keamanan
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=true

# Kiosk QR Monitor
# Kosongkan untuk mengizinkan akses hanya dari admin yang login atau gunakan key acak
KIOSK_KEY=CHANGE_ME_KIOSK_SECRET

# Backup USB
BACKUP_LOCAL_DIR=storage/backups
BACKUP_USB_DIR=/mnt/usb-backup/smart-attendance
BACKUP_RETENTION_DAYS=30

# Akun admin awal (hanya dipakai sekali saat migrasi pertama jika belum ada user)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME="Administrator"
